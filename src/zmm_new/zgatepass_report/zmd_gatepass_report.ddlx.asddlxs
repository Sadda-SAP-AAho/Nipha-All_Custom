  @Consumption.filter.hidden: true
  @UI.lineItem: [ { position: 100 , label: 'Invoice No'} ]
  @UI.identification: [ {position: 100 ,label: 'Invoice No'} ]
  document_no;

  @Consumption.filter.hidden: true
  @UI.lineItem: [ { position: 110 , label: 'Jobber Challan Out'} ]
  @UI.identification: [ {position: 110 ,label: 'Jobber Challan Out'} ]
  jobber_challan;

  @Consumption.filter.hidden: true
  @UI.lineItem: [ { position: 120 , label: 'Challan Date'} ]
  @UI.identification: [ {position: 120 ,label: 'Challan Date'} ]
  challan_date;

  @Consumption.filter.hidden: true
