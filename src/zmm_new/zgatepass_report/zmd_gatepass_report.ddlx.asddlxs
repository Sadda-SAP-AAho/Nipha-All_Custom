  GateEntryTime;

  @Consumption.filter.hidden: true
  @UI.lineItem: [ { position: 70 , label: 'Vehicle Number'} ]
  @UI.identification: [ {position: 70 ,label: 'Vehicle Number'} ]
  vehicle_number;
  
  @Consumption.filter.hidden: true
  @UI.lineItem: [ { position: 75 , label: 'Cancelled'} ]
  @UI.identification: [ {position: 75 ,label: 'Cancelled'} ]
  cancelled;

  @Consumption.filter.hidden: true
  @UI.lineItem: [ { position: 80 , label: 'Supplier/CustomerCode'} ]
