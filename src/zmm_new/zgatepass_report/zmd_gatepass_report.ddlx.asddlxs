@Metadata.layer: #CORE
@UI.selectionVariant: [{ qualifier: 'Pass', text: 'Gate Outward' }]
annotate entity ZCDS_GATEPASS_REPORT with
{
  @UI.selectionField: [{ position: 10 }]
  @EndUserText.label: 'Gate Pass'
  @UI.lineItem: [ { position: 10 , label: 'Gate Pass Number'} ]
  @UI.identification: [ {position: 10 ,label: 'Gate Pass Number'} ]
  GateEntryNo;

  @Consumption.filter.hidden: true
  @UI.lineItem: [ { position: 20 , label: 'Line No'} ]
  @UI.identification: [ {position: 20 ,label: 'Line No'} ]
  pass_line_no;

  @UI.selectionField: [{ position: 20 }]
  @EndUserText.label: 'Plant'
  @UI.lineItem: [ { position: 30 , label: 'Plant'} ]
  @UI.identification: [ {position: 30 ,label: 'Plant'} ]
  Plant;

  @Consumption.filter.hidden: true
  @UI.lineItem: [ { position: 40 , label: 'Gate Pass Type'} ]
  @UI.identification: [ {position: 40 ,label: 'Gate Pass Type'} ]
  type;

  @UI.selectionField: [{ position: 30 }]
  @EndUserText.label: 'Gate Date'
  @UI.lineItem: [ { position: 50 , label: 'Gate Out Date'} ]
  @UI.identification: [ {position: 50 ,label: 'Gate Out Date'} ]
  GateOutDate;
  
  @Consumption.filter.hidden: true
  @UI.lineItem: [ { position: 55 , label: 'Status'} ]
  @UI.identification: [ {position: 55 ,label: 'Status'} ]
  Status;

  @Consumption.filter.hidden: true
