@EndUserText.label: 'Purchase Register'
@Search.searchable: false
//@ObjectModel.query.implementedBy: 'ABAP:ZCL_PURCHASE_REG_NEW'
@UI.headerInfo: {typeName: 'Purchase Register', typeNamePlural: 'Purchase Register'}
@Metadata.allowExtensions: true
define view entity ZCDS_PURCHASE_REG_NEW
  as select from zdt_pur_reg_new        as a
    inner join   I_SupplierInvoiceAPI01 as b on  a.supplierinvoice       = b.SupplierInvoice
                                             and a.fiscalyearvalue       = b.FiscalYear
                                             and b.SupplierInvoiceStatus = '5'
    inner join   zuser_item             as c on a.plant = c.plant
{
  key a.companycode               as Companycode,
  key a.fiscalyearvalue           as Fiscalyearvalue,
  key a.supplierinvoice           as Supplierinvoice,
  key a.supplierinvoiceitem       as Supplierinvoiceitem,
      a.postingdate               as Postingdate,
      a.plant                     as Plant,
      a.plantname                 as Plantname,
      a.plantadr                  as Plantadr,
      a.plantcity                 as Plantcity,
      a.plantgst                  as Plantgst,
      a.plantpin                  as Plantpin,
      a.product                   as Product,
      a.productname               as Productname,
      a.purchaseorder             as Purchaseorder,
      a.transactiontype           as Transactiontype,
      a.vendor_invoice_no         as VendorInvoiceNo,
      a.vendor_invoice_date       as VendorInvoiceDate,
      //    vendor_type as Vendor_type ,
      a.baseunit                  as Baseunit,
      a.profitcenter              as Profitcenter,
      a.purchasingorganization    as Purchasingorganization,
      a.purchasinggroup           as Purchasinggroup,
      a.hsncode                   as Hsncode,
      a.taxcodename               as Taxcodename,
      a.originalreferencedocument as Originalreferencedocument,
      a.igst                      as Igst,
      a.sgst                      as Sgst,
      a.cgst                      as Cgst,
      a.reverseigst               as ReverseIgst,
      a.reversesgst               as ReverseSgst,
      a.reversecgst               as ReverseCgst,
      a.rateigst                  as Rateigst,
      a.ratecgst                  as Ratecgst,
      a.ratesgst                  as Ratesgst,
      a.basicrate                 as Basicrate,
      a.netamount                 as Netamount,
      a.pocurrency                as Pocurrency,
      a.taxamount                 as Taxamount,
      a.tcsamount                 as Tcsamount,
      a.roundoff                  as Roundoff,
      a.manditax                  as Manditax,
      a.mandicess                 as Mandicess,
      a.totalamount               as Totalamount,
      a.othercharges              as Othercharges,
      a.packaging                 as Packaging,
      a.antidumpingper            as Antidumpingper,
      a.antidumpingvalue          as Antidumpingvalue,
      a.chachargesval             as Chachargesval,
      a.cifvalue                  as Cifvalue,
      a.cifandcustomduty          as Cifandcustomduty,
      a.clearingcharges           as Clearingcharges,
      a.freightval                as Freightval,
      a.freightqty                as Freightqty,
      a.insurancechargesper       as Insurancechargesper,
      a.insurancecost             as Insurancecost,
      a.ldguldgchgsqty            as Ldguldgchgsqty,
      a.ldguldgchgsval            as Ldguldgchgsval,
      a.materialgroup             as Materialgroup,
      a.materialtype              as Materialtype,
      a.mirodocumenttype          as Mirodocumenttype,
      a.packingchargesper         as Packingchargesper,
      a.packingchargesqty         as Packingchargesqty,
      a.vendorcode                as Vendorcode,
      a.vendorgstin               as Vendorgstin,
      a.vendorname                as Vendorname,
      a.vendorpanno               as Vendorpanno,
      a.vendortanno               as Vendortanno,
      a.aidcper                   as Aidcper,
      a.brokerchargesqty          as Brokerchargesqty,
      a.brokerchargesval          as Brokerchargesval,
      a.brokervendorcode          as Brokervendorcode,
      a.brokervendorname          as Brokervendorname,
      a.kisankalyantax            as Kisankalyantax,
      a.safeguardper              as Safeguardper,
      a.surveyorchargesqty        as Surveyorchargesqty,
      a.surveyorchargesval        as Surveyorchargesval,
      a.purchasecomissionval      as Purchasecomissionval,
      a.purchasecomissionqty      as Purchasecomissionqty,
      a.mirouom                   as Mirouom,
      a.miroquantity              as Miroquantity,
      a.vendortype                as Vendortype,
      a.miro_item_type            as MiroItemType,
      a.isreversed                as Isreversed,
      a.referenceinvoicenumber    as Referenceinvoicenumber,
      a.exchangerate              as Exchangerate,
      a.supplierinvoiceitemtext   as SupplierInvoiceItemText,
      a.createdby                 as CreatedBy
}
where c.userid = $session. user
