managed with additional save implementation in class ZBP_R_DMS_CONFIG unique;
strict ( 2 );
define behavior for ZR_DMS_CONFIG alias ZrDmsConfig
persistent table zdms_config
etag master LastChangedAt
lock master
authorization master ( global )
{
  field ( mandatory : create )
  Entity;

  field ( readonly )
  CreatedBy,
  CreatedAt,
  LastChangedBy,
  LastChangedAt,
  LocalLastChangedAt;

  field ( readonly : update )
  Entity;


  create;
  update;
  delete;


  //  determination logAction on save { create; update; delete; }


  mapping for zdms_config corresponding
    {
      Entity             = ENTITY;
      Path               = PATH;
      CreatedBy          = CREATED_BY;
      CreatedAt          = CREATED_AT;
      LastChangedBy      = LAST_CHANGED_BY;
      LastChangedAt      = LAST_CHANGED_AT;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    }

}