managed implementation in class ZBP_R_FIPPMAP unique;
strict ( 2 );
with draft;
define behavior for ZR_FIPPMAP
persistent table zfippmap
draft table ZFIPPMAP_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )

{
  field ( readonly )
   UUID,
   LocalCreatedAt,
   LocalCreatedBy,
   LastChangedAt,
   LocalLastChangedAt,
   LocalLastChangedBy;

  field ( numbering : managed )
   UUID;


  create;
  update;
  delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZFIPPMAP
  {
    UUID = uuid;
    Commcc1 = commcc1;
    Commcc2 = commcc2;
    Deptcc = deptcc;
    Prdcc = prdcc;
    Gl = gl;
    ActType = act_type;
    ActCat = act_cat;
    LocalCreatedBy = local_created_by;
    LocalCreatedAt = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
  }
}