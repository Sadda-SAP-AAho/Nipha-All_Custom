@Metadata.layer: #CORE
@UI:{ 
       headerInfo:{ 
                typeName: 'Purchase Register Data',
                typeNamePlural: 'Purchase Register Data',
                title:{ 
                type: #STANDARD,
                label: 'Purchase Register Data',
                value: 'AccountingDocument'
                  }
       }
}
annotate entity ZCPUR_REG_DATA
    with 
{
 @UI.facet: [{ id: 'Shopify_Order_ID',
             purpose: #STANDARD,
             type: #IDENTIFICATION_REFERENCE,
             label: 'PickList Data',
             position: 10
 }]
   @UI: { lineItem: [{ position: 10 , label: 'CompanyCode' }], 
  identification: [{ position: 10 , label: 'CompanyCode'}] } 
