managed implementation in class ZBP_R_TABLE_PLANT000 unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_TABLE_PLANT000 alias ZrTablePlant000
persistent table ztable_plant
extensible
draft table ztable_plnt000_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  //  " EXCEL UPLOAD ACTION
  // static action uploadExcel deep parameter ZI_PLANT_TABLE_EXCEL_UPLOAD;
  //    result [1] $self;

  field ( mandatory : create )
  CompCode,
  PlantCode;

  field ( readonly )
  CreatedBy,
  CreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  field ( readonly : update )
  CompCode,
  PlantCode;


  mapping for ztable_plant corresponding extensible
    {
      CompCode           = comp_code;
      PlantCode          = plant_code;
      CompanyName        = company_name;
      PlantName1         = plant_name1;
      PlantName2         = plant_name2;
      Address1           = address1;
      Address2           = address2;
      Address3           = address3;
      City               = city;
      District           = district;
      StateCode1         = state_code1;
      StateCode2         = state_code2;
      StateName          = state_name;
      Pin                = pin;
      Country            = country;
      CinNo              = cin_no;
      GstinNo            = gstin_no;
      PanNo              = pan_no;
      TanNo              = tan_no;
      Email              = email;
      FssaiNo            = fssai_no;
      MobNo              = mob_no;
      Remark1            = remark1;
      Remark2            = remark2;
      Remark3            = remark3;
      Weightpath         = weightpath;
      WeightpathOut      = weightpath_out;
      Emailtocustomer    = emailtocustomer;
      Fromemail          = fromemail;
      Ccmails            = ccmails;
      Storagelocation    = storagelocation;
      Gspusername        = gspusername;
      Gsppassword        = gsppassword;
      Ewbusername        = ewbusername;
      Ewbpassword        = ewbpassword;
      Businessplace      = businessplace;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }

}