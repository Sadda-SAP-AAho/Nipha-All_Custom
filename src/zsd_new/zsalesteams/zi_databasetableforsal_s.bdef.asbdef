managed implementation in class ZBP_I_DATABASETABLEFORSAL_S unique;
strict;
with draft;
define behavior for ZI_DatabaseTableForSal_S alias DatabaseTableForAll
draft table ZDT_SALESTM_D_S
with unmanaged save
lock master total etag LastChangedAtMax
authorization master( global )
{
  field ( readonly )
   SingletonID;

  field ( notrigger )
   SingletonID,
   LastChangedAtMax;


  update;
  internal create;
  internal delete;

  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  association _DatabaseTableForSal { create ( features : instance ); with draft; }

}

define behavior for ZI_DatabaseTableForSal alias DatabaseTableForSal ##UNMAPPED_FIELD
persistent table ZDT_SALESTM
draft table ZDT_SALESTM_D
etag master LastChangedAt
lock dependent by _DatabaseTableForAll
authorization dependent by _DatabaseTableForAll
{

  field (readonly) Customername, State;

  side effects { field Customerid affects field Customername, field State; }

  determination getCustomerDetails on modify { field Customerid; }


  field ( mandatory : create )
   Customerid,
   Validfrom,
   Validto;

  field ( readonly )
   SingletonID,
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt;

  field ( readonly : update )
   Customerid,
   Validfrom,
   Validto;

  field ( notrigger )
   SingletonID,
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt;


  update( features : global );
  delete( features : global );

  factory action ( features : instance ) Copy parameter ZD_CopyDatabaseTableForSalP [1];

  mapping for ZDT_SALESTM
  {
    Customerid = CUSTOMERID;
    Validfrom = VALIDFROM;
    Validto = VALIDTO;
    Customername = CUSTOMERNAME;
    State = STATE;
    Field = FIELD;
    Degination = DEGINATION;
    Rm = RM;
    Zm = ZM;
    SalesHead = sales_head;
    //SalesHead = SALES_HEAD;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

  association _DatabaseTableForAll { with draft; }

}